# json is on this list because the Firebase service-account key lives in a .json
# file and was being served to anyone who asked. No .json file on this site is
# meant to be public — the API returns JSON generated by PHP, not from files.
<FilesMatch "\.(env|sql|md|log|json|yml|yaml|ini|bak|old|swp|php~)$">
    Require all denied
</FilesMatch>

# Never serve dotfiles (.git, .env, editor leftovers).
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

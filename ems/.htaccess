# ==============================================================================
# Security Rules (CRITICAL: Firebase service-account JSON, configs, dotfiles)
# ==============================================================================
<FilesMatch "\.(env|sql|md|log|json|yml|yaml|ini|bak|old|swp|php~)$">
    Require all denied
</FilesMatch>

# Never serve dotfiles (.git, .env, editor leftovers)
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

Options -Indexes

# ==============================================================================
# Clean URLs & Extensionless PHP Rewrites (mod_rewrite)
# ==============================================================================
<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. External 301 Redirect: /path/file.php -> /path/file (Clean URL in browser)
    # Only applies to direct browser GET/HEAD requests to prevent breaking POST/AJAX
    RewriteCond %{REQUEST_METHOD} !POST
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+([^\s?]+)\.php([?\s]|$) [NC]
    RewriteCond %{THE_REQUEST} !/backend/api/ [NC]
    RewriteRule ^ /%1 [R=301,L,NE]

    # 2. Internal Rewrite: /path/file -> /path/file.php (if .php file exists)
    # Never rewrite real directories or existing static files (CSS, JS, images, PDF, etc.)
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(.*)$ $1.php [QSA,L]

</IfModule>
